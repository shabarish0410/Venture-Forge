POSTGRES_PASSWORD=generate-a-local-secret
PRODUCT_DB_PASSWORD=generate-a-different-secret
COMPANY_DB_PASSWORD=generate-another-secret
DATABASE_URL=postgresql+psycopg://vf_product:replace-me@127.0.0.1:55432/vf_product
TEST_DATABASE_URL=postgresql+psycopg://vf_product:replace-me@127.0.0.1:55432/vf_product_test
APP_ORIGIN=http://127.0.0.1:3000
APP_ENV=development
COOKIE_SECURE=false
SESSION_HOURS=12
BOOTSTRAP_EMAIL=founder@ventureforge.local
BOOTSTRAP_PASSWORD=generate-at-least-16-characters
# OAuth application credentials stay server-side. See docs/sign-in.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MODEL_ROUTER_POLICY=hybrid
MODEL_PROFILES=[]
# Alternatively: MODEL_PROFILES_FILE=.local/model-profiles.json
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
MODEL_MAX_CONTEXT_BYTES=500000
# Legacy single-profile compatibility; new deployments use MODEL_PROFILES.
MODEL_PROVIDER=disabled
MODEL_ID=
MODEL_INPUT_INR_PER_MILLION=0
MODEL_OUTPUT_INR_PER_MILLION=0
